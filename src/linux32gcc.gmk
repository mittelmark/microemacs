##############################################################################
#
# linux32gcc.gmk has been merged with cygwin.gmk into unixgcc.gmk, which
# auto-detects the platform with "uname -o":
#
#   GNU/Linux -> -D_LINUX   output .linux32gcc-*   (unchanged, existing
#                            CI and packaging paths keep working)
#   Cygwin    -> -D_CYGWIN  output .cygwin-*
#   Msys      -> -D_CYGWIN  output .msysunix-*
#
# This shim forwards every target and variable to unixgcc.gmk. It will be
# removed once all references (CI workflows, docs) use unixgcc.gmk directly.
#
##############################################################################
include unixgcc.gmk
