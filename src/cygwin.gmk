##############################################################################
#
# Created:     Sat Jan 24 1998
# Synopsis:    Make file for Cygnus Cygwin v20.1 using gcc
# Notes:
#       The executable produced does not currently work, for some reason ME
#       does not receive any keyboard input and must be killed.
#
#   Run "make -f cygwin.gmk"                for optimised build produces .cygwin-release-mecw/mecw.exe (and me.exe)
#   Run "make -f cygwin.gmk BTYP=c"         for console only  -> .cygwin-release-mec/mec.exe
#   Run "make -f cygwin.gmk BTYP=w"         for window only   -> .cygwin-release-mew/mew.exe
#   Run "make -f cygwin.gmk BTYP=cw"        for both (default)
#   Run "make -f cygwin.gmk BCFG=debug"     for debug build   -> .cygwin-debug-mecw/
#   Run "make -f cygwin.gmk BCOR=ne"        for NanoEmacs
#
#   Legacy targets still work:  mec, mew, mecw, med, medc, etc.
#
#   Run "make -f cygwin.gmk clean"          to clean build dirs (removes .cygwin-*)
#   Run "make -f cygwin.gmk spotless"       to clean even more
#
##############################################################################
#
# Installation Directory
INSTDIR	      = /usr/local/bin
INSTPROGFLAGS = -s -o root -g root -m 0775
#
# Local Definitions
A        = .a
EXE      = .exe

BTYP     ?= cw
BCFG     ?= release
BCOR     ?= me

CC       = gcc
LD       = $(CC)
STRIP    = strip
AR       = ar
CP       = cp
RM       = rm -f
RMDIR    = rm -r -f

BUILDID  = cygwin
OUTDIRR  = .$(BUILDID)-release
OUTDIRD  = .$(BUILDID)-debug
CCDEFS   = -D_CYGWIN -I.
CCFLAGSR = -O3 -DNDEBUG=1 -Wall -Wno-uninitialized -Wno-restrict -Wno-stringop-truncation -Wno-stringop-overflow -Wno-format-overflow
CCFLAGSD = -g -Wall -Wno-restrict -Wno-stringop-truncation -Wno-stringop-overflow -Wno-format-overflow
LDDEFS   =
LDFLAGSR =
LDFLAGSD = -g
LDLIBS   = -lm

ifeq "$(BCFG)" "debug"
BOUTDIR  = $(OUTDIRD)
CCFLAGS  = $(CCFLAGSD)
LDFLAGS  = $(LDFLAGSD)
STRIP    = - echo No strip - debug
else
BOUTDIR  = $(OUTDIRR)
CCFLAGS  = $(CCFLAGSR)
LDFLAGS  = $(LDFLAGSR)
endif

ifeq "$(BCOR)" "ne"
BCOR_CDF = -D_NANOEMACS
PRGLIBS  = -lz
else
BCOR     = me
BCOR_CDF =
PRGLIBS  = -lz
endif

# Window libs - keep original paths
WINDOW_LIBS = -L/usr/X11R6/lib -lX11 -lz $(MAKEWINLIBS)
CONSOLE_LIBS  = -lncurses -lz
CONSOLE_DEFS  = -D_ME_CONSOLE -D_USE_NCURSES -D_USETPARM
WINDOW_DEFS   = $(MAKEWINDEFS) -D_ME_WINDOW -I/usr/X11/include
NANOEMACS_DEFS= -D_NANOEMACS

ifeq "$(BTYP)" "c"
BTYP_CDF = $(CONSOLE_DEFS)
BTYP_LIB = $(CONSOLE_LIBS)
else ifeq "$(BTYP)" "w"
BTYP_CDF = $(WINDOW_DEFS)
BTYP_LIB = $(WINDOW_LIBS)
else
BTYP_CDF = $(CONSOLE_DEFS) $(WINDOW_DEFS)
BTYP_LIB = $(CONSOLE_LIBS) $(WINDOW_LIBS)
BTYP     = cw
endif

OUTDIR   = $(BOUTDIR)-$(BCOR)$(BTYP)
PRGNAME  = $(BCOR)$(BTYP)
PRGFILE  = $(PRGNAME)$(EXE)
PRGHDRS  = ebind.h edef.h eextrn.h efunc.h emain.h emode.h eprint.h \
	   esearch.h eskeys.h estruct.h eterm.h evar.h evers.h eopt.h \
	   ebind.def efunc.def eprint.def evar.def etermcap.def emode.def eskeys.def bfs.h
PRGOBJS  = $(OUTDIR)/abbrev.o $(OUTDIR)/basic.o $(OUTDIR)/bfs.o $(OUTDIR)/bind.o $(OUTDIR)/buffer.o $(OUTDIR)/crypt.o $(OUTDIR)/dirlist.o $(OUTDIR)/display.o \
	   $(OUTDIR)/encoding.o $(OUTDIR)/eval.o $(OUTDIR)/exec.o $(OUTDIR)/file.o $(OUTDIR)/fileio.o $(OUTDIR)/frame.o $(OUTDIR)/hilight.o $(OUTDIR)/history.o $(OUTDIR)/input.o \
	   $(OUTDIR)/isearch.o $(OUTDIR)/key.o $(OUTDIR)/line.o $(OUTDIR)/macro.o $(OUTDIR)/main.o $(OUTDIR)/narrow.o $(OUTDIR)/next.o $(OUTDIR)/osd.o \
	   $(OUTDIR)/print.o $(OUTDIR)/random.o $(OUTDIR)/regex.o $(OUTDIR)/region.o $(OUTDIR)/registry.o $(OUTDIR)/search.o $(OUTDIR)/spawn.o \
	   $(OUTDIR)/spell.o $(OUTDIR)/tag.o $(OUTDIR)/termio.o $(OUTDIR)/time.o $(OUTDIR)/undo.o $(OUTDIR)/window.o $(OUTDIR)/word.o \
	   $(OUTDIR)/unixterm.o
#
# Rules
.SUFFIXES: .c .o

$(OUTDIR)/%.o : %.c
	$(CC) $(CCDEFS) $(BCOR_CDF) $(BTYP_CDF) $(CCFLAGS) -c -o $@ $<

all: $(OUTDIR)/$(PRGFILE)

$(OUTDIR)/$(PRGFILE): $(OUTDIR) $(PRGOBJS)
	$(RM) $@
	$(LD) $(LDDEFS) $(LDFLAGS) -o $@ $(PRGOBJS) $(PRGLIBS) $(BTYP_LIB) $(LDLIBS)
	$(STRIP) $@

$(PRGOBJS): $(PRGHDRS)

$(OUTDIR):
	-mkdir $(OUTDIR)

# Legacy convenience targets (still work, now via sub-make)
# Note: primary output is now $(OUTDIR)/$(PRGFILE) e.g. .cygwin-release-mec/mec.exe
# These wrappers do NOT copy to src/ root to avoid polluting the source dir.
mec:
	$(MAKE) -f cygwin.gmk BTYP=c BCFG=$(BCFG) BCOR=$(BCOR) all

mew:
	$(MAKE) -f cygwin.gmk BTYP=w BCFG=$(BCFG) BCOR=$(BCOR) all

mecw:
	$(MAKE) -f cygwin.gmk BTYP=cw BCFG=$(BCFG) BCOR=$(BCOR) all

me: mecw

# NanoEmacs legacy
nec:
	$(MAKE) -f cygwin.gmk BTYP=c BCFG=$(BCFG) BCOR=ne all

new:
	$(MAKE) -f cygwin.gmk BTYP=w BCFG=$(BCFG) BCOR=ne all

necw:
	$(MAKE) -f cygwin.gmk BTYP=cw BCFG=$(BCFG) BCOR=ne all

ne: nec

# Debug legacy
medc:
	$(MAKE) -f cygwin.gmk BTYP=c BCFG=debug BCOR=$(BCOR) all

medw:
	$(MAKE) -f cygwin.gmk BTYP=w BCFG=debug BCOR=$(BCOR) all

medcw:
	$(MAKE) -f cygwin.gmk BTYP=cw BCFG=debug BCOR=$(BCOR) all

med: medcw

nedc:
	$(MAKE) -f cygwin.gmk BTYP=c BCFG=debug BCOR=ne all

nedw:
	$(MAKE) -f cygwin.gmk BTYP=w BCFG=debug BCOR=ne all

nedcw:
	$(MAKE) -f cygwin.gmk BTYP=cw BCFG=debug BCOR=ne all

ned: nedc

clean:
	$(RMDIR) .$(BUILDID)-release-* .$(BUILDID)-debug-*
	$(RM) core me$(EXE) mec$(EXE) mew$(EXE) mecw$(EXE) ne$(EXE) nec$(EXE) new$(EXE) necw$(EXE) med$(EXE) medc$(EXE) medw$(EXE) medcw$(EXE) ned$(EXE) nedc$(EXE) nedw$(EXE) nedcw$(EXE)
	$(RM) *.oc *.ow *.ob *.on *.ov *.oe *.odc *.odw *.odb *.odn *.odv *.ode
	$(RM) *.o

spotless: clean
	$(RM) tags *~
