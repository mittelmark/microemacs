##-*- makefile -*-############################################################
#
#version=091224b1
VERSION := $(shell grep -E 'meYEAR|meMONTH|meDAY' src/evers.h  | head -n 3 | grep -Eo '[0-9b]+' | paste -sd '' | sed 's/0909/09/')
CC=gcc-11
MAKE=make
##MAKE=/usr/local/opt/make/libexec/gnubin/make
KERNEL := $(shell uname -r | grep -oE '^[0-9]+' | sed 's/21/12/' | sed 's/22/13/' | sed 's/23/14/' | sed 's/24/15/' | sed 's/25/26/')
OS := macos-$(KERNEL)
ARCH := $(shell uname -m)
RELEASE := "macos-$(KERNEL)-$(ARCH)-microemacs-$(VERSION)"
app=mecb
#
# Auto-detect libXft for mew/mecw (XQuartz + freetype/fontconfig + pkg-config).
# Override with XFT=0 or XFT=1 on the make command line.
#
PKG_CONFIG ?= pkg-config
ifneq ($(wildcard /opt/X11/lib/pkgconfig),)
export PKG_CONFIG_PATH := /opt/X11/lib/pkgconfig:$(PKG_CONFIG_PATH)
endif
XFT=0
XFTDIR=
ifeq (0,$(shell $(PKG_CONFIG) --exists xft 2>/dev/null; echo $$? ))
XFT=1
XFTDIR=-xft
endif
bfs/bin:
	echo "VERSION: $(VERSION)"
	cd bfs && $(MAKE) CC=$(CC)

mec:
	cd src && $(MAKE) -f macos32gcc.gmk CC=$(CC) BTYP=c

mew:
	cd src && $(MAKE) -f macos32gcc.gmk CC=$(CC) BTYP=w XFT=$(XFT)

mecw:
	cd src && $(MAKE) -f macos32gcc.gmk CC=$(CC) BTYP=cw XFT=$(XFT)

mecb: mec bfs/bin
	./bfs/bfs -a ./src/.macos32gcc-release-mec/mec -o $(RELEASE)-mecb.bin ./jasspa

mewb: mew bfs/bin
	./bfs/bfs -a ./src/.macos32gcc-release-mew$(XFTDIR)/mew -o $(RELEASE)-mewb.bin ./jasspa

mecwb: mecw bfs/bin
	./bfs/bfs -a ./src/.macos32gcc-release-mecw$(XFTDIR)/mecw -o $(RELEASE)-mecwb.bin ./jasspa

version:
	echo "VERSION: $(VERSION)"
	echo "XFT: $(XFT)"

release: $(app)
	make -f release.gmk app=$(app) RELEASE=$(RELEASE) ext=bin

brew: mecb mewb
	mkdir -p brew-macos-$(VERSION)/bin
	cp $(RELEASE)-mecb.bin   brew-macos-$(VERSION)/bin/mecb
	cp $(RELEASE)-mewb.bin   brew-macos-$(VERSION)/bin/mewb	
	cp bin/mecu              brew-macos-$(VERSION)/bin/mecu
	chmod 755                brew-macos-$(VERSION)/bin/mecu
	cp COPYING               brew-macos-$(VERSION)/license.txt
	cp README-standalone.md  brew-macos-$(VERSION)/README.md
	tar cfz brew-macos-$(VERSION).tar.gz brew-macos-$(VERSION)/*
	sha256sum brew-macos-$(VERSION).tar.gz > brew-macos-$(VERSION).sha256
