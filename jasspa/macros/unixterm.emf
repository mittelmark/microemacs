define-macro-file hkman man
define-macro-file hkipipe ishell gdb dbx perldb
add-file-hook ".C" fhook-cpp
0 define-macro exec-me
    ipipe-shell-command &spr "\"%s\" %s" $progname @1 @mna
!emacro

; TODO check on more platforms
; found it on MacOS Quartz, Ubuntu 18, Fedora 30, Fedora 38
set-variable .change-font.sz-size 17
set-variable .change-font.sz-fonts "|courier|lucidatypewriter|"
set-variable .change-font.sz-font "-*-courier-bold-r-*-*-%d-*-*-*-*-*-*-*"
set-variable .change-font.charsets  "|ISO-Latin-1|ISO-C-EUR|ISO-S-EUR|ISO-N-EUR|ISO-CYR|ISO-GREEK|ISO-TURK|ISO-NORTH|ISO-BALT|ISO-W-EURO|WIN-ANSI|koi8-r|plain-text|"
set-variable .change-font.encodings "|iso8859-1|iso8859-2|iso8859-3|iso8859-4|iso8859-5|iso8859-7|iso-8859-9|iso-8859-10|is8859-13|iso8859-15|microsoft-cp1252|koi8-r|ascii-0|"
set-variable .change-font.xfontsel 0

;set-variable .change-font.sz-fonts "|courier-medium|courier-bold|lucidatypewriter-medium|lucidatypewriter-bold|"
!if &band $system 0x01
  ; Not using X
  !if &not &band $system 0x02
    ; no color - change the window chars so osd is more usable
    set-variable $window-chars &spr "%s=x*[>]<%s" &lef $window-chars 47 &rig $window-chars 54
  !endif
  ; suspend only on Terminal without questioning
  global-unbind-key "C-z"
  0 global-bind-key suspend-emacs "C-z"
  0 global-bind-key suspend-emacs "C-c z" ; me25 compatible
!else
  ;
!endif
;
; setup the next-error stuff including grep and compiling
;
set-variable $line-template "[0-9]+"
set-variable $file-template "[!-9;-z~]+"
set-variable %ipipe-term "TERM=vt100-nam"
; Grep stuff
set-variable %xgrep-com "grep -n"
; RCS stuff
set-variable $rcs-file     "RCS/%f,v"
set-variable $rcs-co-com   "co %f"
set-variable $rcs-cou-com  "co -l %f"
set-variable $rcs-ci-com   "ci -u -m\"%m\" %f"
;set-variable $rcs-cif-com  "ci -u -m\"%m\" %f"
; Declare the .dir file found in X11 font directory, this is not an info file.
add-file-hook ".dir"                                          fhook-txt

set-variable #l0 &reg &spr "/history/%s/char-set" %platform ""
!if &seq #l0 "iso8859-15"
  translate-key "\x80" "\xa4"
!endif

0 define-macro unixterm-colors-auto-enable
    set-variable #l0 &cat "256" "color"
    set-variable #l1 &cat "256" "-colour"
    !if &or &seq $TERM #l0 &seq $TERM #l1
        set-variable %unixterm-auto-color 1
        set-variable %unixterm-color-count 256
        !return
    !endif
    !if &or &seq &rig $TERM 9 "screen-256color" &seq &rig $TERM 9 "tmux-256color"
        set-variable %unixterm-auto-color 1
        set-variable %unixterm-color-count 256
        !return
    !endif
    !if &sin "256color" $TERM
        set-variable %unixterm-auto-color 1
        set-variable %unixterm-color-count 256
        !return
    !endif
    set-variable %unixterm-auto-color 0
    set-variable %unixterm-color-count 0
!emacro

!force unixterm-colors-auto-enable

!if &or &seq $platform "cygwin" &seq $platform "unix"
    !if &not %unixterm-auto-color
        !if &or &seq $TERM "xterm" &seq $TERM "rxvt" &seq $TERM "screen"
            set-variable %unixterm-auto-color 1
            set-variable %unixterm-color-count 8
        !endif
    !endif
!endif

!if &and %unixterm-auto-color &not &band $system 0x004
    set-variable $system &bor $system 0x004
!endif
!if &and %unixterm-auto-color &gre %unixterm-color-count 16 &not &band $system 0x008
    set-variable $system &bor $system 0x008
!endif

define-macro copy-region-clipboard
  ; Copy the region to the kill buffer
  copy-region
  !if &not $status
    ml-write "[No region selected]"
    !abort
  !endif
  
  ; Save the current buffer name for later
  set-variable #l0 $buffer-fname
  set-variable $debug 1
  ; Create a temp buffer to hold the clipboard content
  !force delete-buffer "*clipboard-tmp*"
  find-buffer "*clipboard-tmp*"
  yank
  
  ; Write to a temp file
  set-variable #l1 $temp-name
  set-variable $buffer-fname #l1
  !force !force 0 write-buffer #l1
  !if &not $status
    ml-write "[Failed to create temp file]"
    delete-buffer "*clipboard-tmp*"
    set-variable $buffer-fname #l0
    !abort
  !endif
  
  ; Check that temp file exists
  !if &not &exi #l1
    ml-write &cat &cat "[Temp file not found: " #l1 "]"
    delete-buffer "*clipboard-tmp*"
    set-variable $buffer-fname #l0
    !abort
  !endif
  
  ; Determine which clipboard tool to use
  set-variable #l2 ""
  ; Check for WSL/Cygwin first (clip.exe)
  set-variable #l3 &which "clip.exe"
  !if &not &seq #l3 "ERROR"
    set-variable #l2 "clip.exe <"
  !else
    ; Check for Cygwin with full path to clip.exe
    !if &seq %platform "cygwin"
      set-variable #l3 &which "/cygdrive/c/Windows/System32/clip.exe"
      !if &not &seq #l3 "ERROR"
        set-variable #l2 &cat #l3 " <"
      !endif
    !endif
    !if &seq #l2 ""
      set-variable #l3 &which "wl-copy"
      !if &seq #l3 "ERROR"
        set-variable #l3 &which "xclip"
        !if &seq #l3 "ERROR"
          ; Try xsel as alternative to xclip
          set-variable #l3 &which "xsel"
          !if &seq #l3 "ERROR"
            set-variable #l3 &which "pbcopy"
            !if &not &seq #l3 "ERROR"
              set-variable #l2 "pbcopy <"
            !endif
          !else
            set-variable #l2 "xsel --clipboard --input <"
          !endif
        !else
          set-variable #l2 "xclip -selection clipboard -i"
        !endif
      !else
        ; or "wl-copy < <(cat filename) to avoid isses with trainling newlines
        set-variable #l2 "wl-copy <"
      !endif
    !endif
  !endif
  
  ; Pipe the temp file to the clipboard tool
  !if &seq #l2 ""
    ml-write "[No clipboard tool found]"
    !force delete-buffer "*clipboard-tmp*"
    set-variable $buffer-fname #l0
    !return
  !endif
  set-variable #l4 &spr "%s %s" #l2 #l1
  shell-command #l4
  
  !if $status
    ml-write &cat &cat "[Copied to clipboard via " #l2 "]"
  !else
    ml-write &cat &cat "[Clipboard copy failed: " #l2 "]"
  !endif
  
  ; Clean up
  shell-command &cat &cond &band $system 0x100 "erase " "rm " #l1
  delete-buffer "*clipboard-tmp*"
  set-variable $buffer-fname #l0
!emacro

; Bind to C-c c
;global-bind-key copy-region-clipboard "C-c c"
  
