; -!- emf -!-
; This is part of the JASSPA MicroEmacs macro files
; Copyright (C) 2026 JASSPA (www.jasspa.com)
; See the file me.emf for copying and conditions.
;
; Synopsis:    Project browser - workspace file tree with git status
; Authors:     Detlef Groth
;
; pview - Project/workspace browser showing the directory tree of the
; directory from which MicroEmacs was started (or an optional path).
;
; Layout (Ticket 11):
;   > closed dir
;   v open dir
;      .hidden (grey)
;      filename.txt (color)    M (indicator)
;      newname.txt (color)     A (git indicator)
;
; Navigation: Return/click open file or toggle dir, Tab/S-tab move,
; Space page down, r refresh (incl. git status), q quit.
;

; ========================
; File hook setup
; ========================

define-macro fhook-pview
    set-variable $buffer-mask "luh12"
    @# buffer-init "pview"
    set-variable :mouse-word-select pview-select
    ; Left click: specific handlers override the toolbar's :mouse-pick-all /
    ; :mouse-drop-all dummy (toolbar.emf installs those for new tool buffers,
    ; which otherwise swallow clicks in the Project View tool window).
    set-variable :mouse-pick-1 mouse-void
    set-variable :mouse-drop-1 pview-select
    set-variable :mouse-pick-3 pview-mouse-pick-3
    set-variable :mouse-drop-3 pview-mouse-drop-3
    !if &seq $buffer-bname "*pview*"
        buffer-bind-create "bio" "return" "0" pview-select
        buffer-bind-create "bio" "tab"   "" pview-next-line
        buffer-bind-create "bio" "S-tab" "" pview-prev-line
        buffer-bind-create "bio" "space" "" scroll-down
        buffer-bind-create "bio" "b"     "" beginning-of-buffer
        buffer-bind-create "bio" "q"     "" pview-quit
        buffer-bind-create "bio" "r"     "" pview-refresh
    !endif
    buffer-init-hooks
!emacro

; buffer-init variables
set-variable .fhook-pview.name "Project View"
set-variable .fhook-pview.setup &reg "/history/fhook/pview" "ghmopWU"
set-variable .fhook-pview.setup-mask "aghmopWU1"
set-variable .fhook-pview.command-flag  "|thbio|thbio|th|thbio|thbio|bio|bio|"
set-variable .fhook-pview.command-name  "|pview-next-line|pview-prev-line|scroll-down|pview-select|pview-quit|pview-refresh|beginning-of-buffer|"
set-variable .fhook-pview.command-nbind "||||0|"
set-variable .fhook-pview.command-kbind "|tab|S-tab|space|return|q|r|b|"
set-variable .fhook-pview.command-desc  "|Move to \HNext Entry|Move to \HPrevious Entry|Page Down|Open File / Toggle \HDirectory|Quit \HProject View|Refresh \HView (git status)|Move to \HTop|"
; Enable hilight by default
set-variable .fhook-pview.setup "ghmopWU"

; ========================
; Hilight definitions
; ========================

!if &and &sin "h" .fhook-pview.setup &band .hilight.flags 0x01
    !if &not &exist .hilight.pview
        set-variable .hilight.pview &pinc .hilight.next 1
    !endif

    0 hilight .hilight.pview 2 50                    $global-scheme
    ; Markers inserted by pview-render
    hilight .hilight.pview 0x44 "\ecD" "" "\ecA" "" "" .scheme.bold       ; root line
    hilight .hilight.pview 0x44 "\ecC" "" "\ecA" "" "" .scheme.dir-closed ; closed dir
    hilight .hilight.pview 0x44 "\ecO" "" "\ecA" "" "" .scheme.dir-open   ; open dir
    hilight .hilight.pview 0x44 "\ecH" "" "\ecA" "" "" .scheme.hide       ; hidden entries
    hilight .hilight.pview 0x44 "\ecF" "" "\ecA" "" "" .scheme.file       ; regular files
    hilight .hilight.pview 0x44 "\ecI" "" "\ecA" "" "" .scheme.hlyellow   ; git indicators
    hilight .hilight.pview 0x44 "\ecM" "" "\ecA" "" "" .scheme.comment    ; "... N more" paging line
!endif

; ========================
; pview main command
; ========================

define-macro pview
    ; Optional directory argument, default = directory ME was started from
    !force set-variable #l0 @1
    !if &not $status
        set-variable #l0 &stat "a" "."
    !endif
    !if &seq #l0 ""
        ml-write "pview: no directory"
        !return
    !endif
    ; Ensure trailing directory separator (idempotent)
    !if &not &seq &rig #l0 -1 "/"
        set-variable #l0 &cat #l0 "/"
    !endif
    ; Collapse any double separators from concatenation
    set-variable #l0 &rep #l0 "//" "/"
    ; Create or reuse *pview* buffer via popup split
    !force 1 popup-window "*pview*"
    !if &not &exist .pview.open
        set-variable .pview.open "|"
    !endif
    ; Default icons off (set .pview.icons to 1 to enable UTF-8 icons)
    !if &not &exist .pview.icons
        set-variable .pview.icons 0
    !endif
    ; Pagination defaults: entries shown per directory / added per click
    !if &not &exist .pview.pagelen
        set-variable .pview.pagelen 20
    !endif
    !if &not &exist .pview.pagestep
        set-variable .pview.pagestep 100
    !endif
    ; Fresh view: drop any previously expanded per-directory limits
    set-variable .pview.limit-path "|"
    set-variable .pview.limit-val "|"
    ; Root always starts open
    !if &not &lfind .pview.open #l0
        set-variable .pview.open &lins .pview.open -1 #l0
    !endif
    set-variable .pview.root #l0
    ; Set fhook BEFORE git-status (which switches buffers)
    set-variable $buffer-fhook "fhook-pview"
    ; git-status switches to *pview-git* internally; save and restore buffer
    set-variable #l9 $buffer-bname
    pview-git-status
    ; Ensure we're back in *pview* before rendering
    !force 0 find-buffer #l9
    pview-render
    beginning-of-buffer
    ml-write &spr "Project view: %s" #l0
!emacro

; ========================
; Git status cache
; ========================

; pview-git-unquote <path>
; Decode a git C-quoted porcelain path (e.g. "hell\303\266chen.R" or
; "with space.txt") into the raw bytes used by the file system -> $result.
; Handles \\ \" \a \b \f \n \r \t \v and \nnn octal escapes.
; Strings that are not quoted are returned unchanged.
0 define-macro pview-git-unquote
    set-variable #l0 @1
    set-variable $result #l0
    !if &not &seq &lef #l0 1 "\""
        !return
    !endif
    ; strip the surrounding quotes
    set-variable #l0 &mid #l0 1 &sub &len #l0 2
    set-variable #l1 ""
    set-variable #l2 0
    set-variable #l3 &len #l0
    !while &less #l2 #l3
        set-variable #l4 &mid #l0 #l2 1
        !if &seq #l4 "\\"
            ; escape sequence - consume the backslash
            set-variable #l2 &add #l2 1
            set-variable #l4 &mid #l0 #l2 1
            !if &seq #l4 "a"
                set-variable #l4 &ito 7
            !elif &seq #l4 "b"
                set-variable #l4 &ito 8
            !elif &seq #l4 "t"
                set-variable #l4 &ito 9
            !elif &seq #l4 "n"
                set-variable #l4 &ito 10
            !elif &seq #l4 "v"
                set-variable #l4 &ito 11
            !elif &seq #l4 "f"
                set-variable #l4 &ito 12
            !elif &seq #l4 "r"
                set-variable #l4 &ito 13
            !elif &and &gre &ato #l4 47 &less &ato #l4 56
                ; octal escape, up to three digits
                set-variable #l5 &sub &ato #l4 48
                set-variable #l6 1
                !while &less #l6 3
                    set-variable #l7 &mid #l0 &add #l2 1 1
                    !if &and &seq &len #l7 1 &and &gre &ato #l7 47 &less &ato #l7 56
                        set-variable #l5 &add &mul #l5 8 &sub &ato #l7 48
                        set-variable #l2 &add #l2 1
                        set-variable #l6 &add #l6 1
                    !else
                        set-variable #l6 3
                    !endif
                !done
                ; raw byte, e.g. \303\266 builds the UTF-8 umlaut
                !if #l5
                    set-variable #l4 &ito #l5
                !else
                    set-variable #l4 ""
                !endif
            !endif
            ; \" and \\ fall through and keep the escaped character
        !endif
        set-variable #l1 &cat #l1 #l4
        set-variable #l2 &add #l2 1
    !done
    set-variable $result #l1
!emacro

0 define-macro pview-git-status
    set-variable .pview.git-path "|"
    set-variable .pview.git-stat "|"
    set-variable .pview.repo ""
    ; Find git repository root
    !force !force 2 pipe-shell-command &spr "git -c core.quotePath=false -C \"%s\" rev-parse --show-toplevel" &rep .pview.root "\\" "/" "*pview-git*"
    !if &not $status
        ; git missing or not a repository - no indicators, clean up the temp buffer
        !force delete-buffer "*pview-git*"
        !return
    !endif
    !force 0 find-buffer "*pview-git*"
    !if &not $status
        !force delete-buffer "*pview-git*"
        !return
    !endif
    ; Skip 3 header lines (cd, command, empty) added by pipeShellCommand
    ; Actual output starts at line 4
    beginning-of-buffer
    4 goto-line
    !force set-variable #l0 &trb @wl
    !if &seq #l0 ""
        delete-buffer "*pview-git*"
        !return
    !endif
    delete-buffer "*pview-git*"
    ; Must look like an absolute path
    !if &not &seq &lef #l0 1 "/"
        !return
    !endif
    set-variable .pview.repo #l0
    ; Porcelain status
    !force !force 2 pipe-shell-command &spr "git -c core.quotePath=false -C \"%s\" status --porcelain" &rep .pview.root "\\" "/" "*pview-git*"
    !if &not $status
        !force delete-buffer "*pview-git*"
        !return
    !endif
    !force 0 find-buffer "*pview-git*"
    !if &not $status
        !force delete-buffer "*pview-git*"
        !return
    !endif
    ; Skip 3 header lines (cd, command, empty) added by pipeShellCommand
    ; Actual output starts at line 4
    beginning-of-buffer
    4 goto-line
    !while $status
        set-variable #l1 @wl
        !if &gre &len #l1 3
            set-variable #l2 &lef #l1 2
            set-variable #l3 &trb &rig #l1 3
            ; Renames: "old -> new" - use the new path
            !if &sin "->" #l3
                set-variable #l3 &trb &rig #l3 &add &rsin "->" #l3 2
            !endif
            ; Git C-quotes paths containing spaces or control characters
            ; (and non-ASCII if core.quotePath is enabled). Decode the quotes
            ; to raw bytes so the path matches the directory listing.
            pview-git-unquote #l3
            set-variable #l3 &cat .pview.repo &cat "/" $result
            set-variable #l4 ""
            !if &seq #l2 "??"
                set-variable #l4 "U"
            !elif &sin "D" #l2
                set-variable #l4 "D"
            !elif &sin "M" #l2
                set-variable #l4 "M"
            !elif &sin "A" #l2
                set-variable #l4 "A"
            !elif &sin "R" #l2
                set-variable #l4 "R"
            !elif &sin "C" #l2
                set-variable #l4 "C"
            !endif
            !if &not &seq #l4 ""
                set-variable .pview.git-path &lins .pview.git-path -1 #l3
                set-variable .pview.git-stat &lins .pview.git-stat -1 #l4
            !endif
        !endif
        !force forward-line
    !done
    delete-buffer "*pview-git*"
!emacro

; ========================
; Render the tree
; ========================

0 define-macro pview-render
    set-variable .pview.entries "|"
    ; Safety limit for the iterative traversal (guards against symlink loops)
    !if &not &exist .pview.maxdepth
        set-variable .pview.maxdepth 40
    !endif
    ; Must disable view mode to allow modifications
    -1 buffer-mode "view"
    -1 buffer-mode "undo"
    ; Clear buffer content - use delete-region from start to end
    beginning-of-buffer
    set-mark
    end-of-buffer
    !force 1 kill-region
    ; Ensure buffer is empty (fallback if kill-region failed)
    !if &gre $window-eline 1
        beginning-of-buffer
        set-mark
        end-of-buffer
        1 kill-region
    !endif
    ; Root line: basename only
    set-variable #l0 &lef .pview.root &sub &len .pview.root 1
    set-variable #l1 &rig #l0 &rsin "/" #l0
    insert-string "\ecD"
    insert-string #l1
    insert-string "\ecA"
    pview-emit-git .pview.root 1
    insert-newline
    ; Root entry stores an empty path (relative to itself)
    set-variable .pview.entries &lins .pview.entries -1 ""
    !if &lfind .pview.open .pview.root
        pview-render-dir .pview.root 1
    !endif
    ; Re-enable view mode
    -1 buffer-mode "edit"
    1 buffer-mode "view"
!emacro

; ========================
; Pagination (large directories)
; ========================

; pview-dir-limit <dirpath/>
; Effective number of entries shown for a directory -> $result
0 define-macro pview-dir-limit
    !if &not &exist .pview.pagelen
        set-variable .pview.pagelen 20
    !endif
    !if &not &exist .pview.limit-path
        set-variable .pview.limit-path "|"
        set-variable .pview.limit-val "|"
    !endif
    set-variable #l0 @1
    set-variable #l1 &lfind .pview.limit-path #l0
    !if &gre #l1 0
        set-variable $result &lget .pview.limit-val #l1
    !else
        set-variable $result .pview.pagelen
    !endif
!emacro

; pview-bump-limit <dirpath/>
; Increase the display limit for <dirpath/> by .pview.pagestep
0 define-macro pview-bump-limit
    !if &not &exist .pview.pagestep
        set-variable .pview.pagestep 100
    !endif
    !if &not &exist .pview.limit-path
        set-variable .pview.limit-path "|"
        set-variable .pview.limit-val "|"
    !endif
    !if &not &exist .pview.pagelen
        set-variable .pview.pagelen 20
    !endif
    set-variable #l0 @1
    set-variable #l1 &lfind .pview.limit-path #l0
    !if &gre #l1 0
        set-variable #l2 &add &lget .pview.limit-val #l1 .pview.pagestep
        set-variable .pview.limit-val &lset .pview.limit-val #l1 #l2
    !else
        set-variable .pview.limit-path &lins .pview.limit-path -1 #l0
        set-variable .pview.limit-val &lins .pview.limit-val -1 &add .pview.pagelen .pview.pagestep
    !endif
!emacro

; pview-emit-more <dirpath/> <depth> <remaining>
; Appends the "... N more ..." paging line and its pseudo-entry
0 define-macro pview-emit-more
    set-variable #l0 @1
    set-variable #l1 @2
    set-variable #l2 @3
    ; Indent: 2 spaces per level (matches siblings)
    set-variable #l3 &mul #l1 2
    set-variable #l4 0
    !while &less #l4 #l3
        insert-string " "
        set-variable #l4 &add #l4 1
    !done
    insert-string "\ecM"
    insert-string &spr "... %d more ..." #l2
    insert-string "\ecA"
    insert-newline
    set-variable .pview.entries &lins .pview.entries -1 &cat "..." &rig #l0 &len .pview.root
!emacro

; pview-render-dir <dirpath/> <depth>
; depth 1 = direct children of root
;
; Iterative depth-first traversal using a depth-indexed frame stack. The
; previous implementation recursed through pview-emit-dir/pview-render-dir
; for every open directory, which hit the ME macro recursion limit
; (meMACRO_DEPTH_MAX, 20 frames) after ~8 open levels. Frames hold only the
; currently visible children, so memory stays bounded by the open branches.
0 define-macro pview-render-dir
    set-variable #l0 @1
    set-variable #l1 @2
    pview-frame-push #l0 #l1
    set-variable #l2 #l1
    !while &gre #l2 0
        ; next sub-directory of this frame
        set-variable #l3 &ind &cat "%pview.si" #l2
        set-variable #l4 &ind &cat "%pview.sd" #l2
        !if &not &gre #l3 &llen #l4
            set-variable #l5 &lget #l4 #l3
            set-variable &cat "%pview.si" #l2 &add #l3 1
            pview-emit-dir #l5 #l2
            !if &gre &lfind .pview.open #l5 0
                !if &less #l2 .pview.maxdepth
                    set-variable #l2 &add #l2 1
                    pview-frame-push #l5 #l2
                !endif
            !endif
        !else
            ; next file of this frame
            set-variable #l3 &ind &cat "%pview.sj" #l2
            set-variable #l4 &ind &cat "%pview.sf" #l2
            !if &not &gre #l3 &llen #l4
                set-variable #l5 &lget #l4 #l3
                set-variable &cat "%pview.sj" #l2 &add #l3 1
                pview-emit-file #l5 #l2
            !else
                ; frame done - emit the paging line then pop
                set-variable #l3 &ind &cat "%pview.se" #l2
                set-variable #l4 &ind &cat "%pview.st" #l2
                !if &gre #l4 #l3
                    set-variable #l6 &ind &cat "%pview.sp" #l2
                    pview-emit-more #l6 #l2 &sub #l4 #l3
                !endif
                !force unset-variable &cat "%pview.sd" #l2
                !force unset-variable &cat "%pview.sf" #l2
                !force unset-variable &cat "%pview.si" #l2
                !force unset-variable &cat "%pview.sj" #l2
                !force unset-variable &cat "%pview.se" #l2
                !force unset-variable &cat "%pview.st" #l2
                !force unset-variable &cat "%pview.sp" #l2
                set-variable #l2 &sub #l2 1
            !endif
        !endif
    !done
!emacro

; pview-frame-push <dirpath/> <depth>
; Build the child lists for one directory and store them in the frame
; variables used by pview-render-dir: sd (dirs), sf (files), si/sj (cursor),
; se (emitted), st (total) and sp (directory for the "... N more" line).
0 define-macro pview-frame-push
    set-variable #l0 @1
    set-variable #l1 @2
    pview-listdir #l0
    set-variable #l2 &llen .pview.ld-dirs
    set-variable #l3 &llen .pview.ld-files
    pview-dir-limit #l0
    set-variable #l4 $result
    set-variable &cat "%pview.sd" #l1 "|"
    set-variable &cat "%pview.sf" #l1 "|"
    set-variable #l5 0
    set-variable #l6 0
    !while &les &pinc #l6 1 #l2
        !if &less #l5 #l4
            set-variable #l7 &ind &cat "%pview.sd" #l1
            set-variable #l7 &lins #l7 -1 &cat #l0 &lget .pview.ld-dirs #l6
            set-variable &cat "%pview.sd" #l1 #l7
            set-variable #l5 &add #l5 1
        !endif
    !done
    set-variable #l6 0
    !while &les &pinc #l6 1 #l3
        !if &less #l5 #l4
            set-variable #l7 &ind &cat "%pview.sf" #l1
            set-variable #l7 &lins #l7 -1 &cat #l0 &lget .pview.ld-files #l6
            set-variable &cat "%pview.sf" #l1 #l7
            set-variable #l5 &add #l5 1
        !endif
    !done
    set-variable &cat "%pview.si" #l1 1
    set-variable &cat "%pview.sj" #l1 1
    set-variable &cat "%pview.se" #l1 #l5
    set-variable &cat "%pview.st" #l1 &add #l2 #l3
    set-variable &cat "%pview.sp" #l1 #l0
!emacro

; pview-listdir <dirpath/>
; Sets .pview.ld-dirs and .pview.ld-files to sorted entry names
; relative to <dirpath/> (dirs keep trailing /). Skips ./ and ../.
0 define-macro pview-listdir
    set-variable .pview.ld-dirs "|"
    set-variable .pview.ld-files "|"
    set-variable #l0 @1
    set-variable $file-names &cat #l0 ".*"
    !while &not &seq &set #l1 $file-names ""
        !if &or &seq #l1 "./" &seq #l1 "../"
            ; skip self references
        !elif &seq &rig #l1 -1 "~"
            ; skip editor backup files (name~)
        !else
            !if &seq &rig #l1 -1 "/"
                set-variable .pview.ld-dirs &lins .pview.ld-dirs -1 #l1
            !else
                set-variable .pview.ld-files &lins .pview.ld-files -1 #l1
            !endif
        !endif
    !done
!emacro

; pview-emit-dir <fullpath/> <depth>
0 define-macro pview-emit-dir
    set-variable #l0 @1
    set-variable #l1 @2
    set-variable #l2 &lfind .pview.open #l0
    set-variable #l3 0
    !if &gre #l2 0
        set-variable #l3 1
    !endif
    ; Basename without trailing /
    set-variable #l4 &lef #l0 &sub &len #l0 1
    set-variable #l4 &rig #l4 &rsin "/" #l4
    ; Indent: 2 spaces per level (depth 1 = 2 spaces, depth 2 = 4, etc.)
    set-variable #l5 &mul #l1 2
    set-variable #l6 0
    !while &less #l6 #l5
        insert-string " "
        set-variable #l6 &add #l6 1
    !done
    ; Colour: hidden overrides open/closed; otherwise open vs closed
    !if &seq &lef #l4 1 "."
        insert-string "\ecH"
    !else
        !if #l3
            insert-string "\ecO"
        !else
            insert-string "\ecC"
        !endif
    !endif
    ; Icon or expand marker
    !if .pview.icons
        !if #l3
            insert-string "📂 "    ; open folder
        !else
            insert-string "📁 "    ; closed folder
        !endif
    !else
        !if #l3
            insert-string "v "
        !else
            insert-string "> "
        !endif
    !endif
    insert-string #l4
    insert-string "/"
    insert-string "\ecA"
    pview-emit-git #l0 1
    insert-newline
    ; Entries store paths relative to .pview.root (keeps the list small)
    set-variable .pview.entries &lins .pview.entries -1 &rig #l0 &len .pview.root
!emacro

; pview-emit-file <fullpath> <depth>
0 define-macro pview-emit-file
    set-variable #l0 @1
    set-variable #l1 @2
    ; Basename
    set-variable #l2 &rig #l0 &rsin "/" #l0
    ; Indent: 2 spaces per level (depth 1 = 2 spaces, depth 2 = 4, etc.)
    set-variable #l3 &mul #l1 2
    set-variable #l4 0
    !while &less #l4 #l3
        insert-string " "
        set-variable #l4 &add #l4 1
    !done
    !if &seq &lef #l2 1 "."
        insert-string "\ecH"
    !else
        insert-string "\ecF"
    !endif
    ; Icon or nothing
    !if .pview.icons
        insert-string "📄 "    ; page
    !endif
    insert-string #l2
    insert-string "\ecA"
    pview-emit-git #l0 0
    insert-newline
    set-variable .pview.entries &lins .pview.entries -1 &rig #l0 &len .pview.root
!emacro

; pview-emit-git <fullpath> <isdir>
; Files: letter from git status. Dirs: bullet if any tracked change below.
0 define-macro pview-emit-git
    set-variable #l0 @1
    set-variable #l1 @2
    set-variable #l2 ""
    !if #l1
        set-variable #l3 1
        !while &les #l3 &llen .pview.git-path
            !if &seq #l2 ""
                set-variable #l4 &lget .pview.git-path #l3
                !if &equ &lef #l4 &len #l0 #l0
                    set-variable #l2 "•"
                !endif
            !endif
            set-variable #l3 &add #l3 1
        !done
    !else
        set-variable #l3 &lfind .pview.git-path #l0
        !if &gre #l3 0
            set-variable #l2 &lget .pview.git-stat #l3
        !endif
    !endif
    !if &not &seq #l2 ""
        insert-string "    "
        insert-string "\ecI"
        insert-string #l2
        insert-string "\ecA"
    !endif
!emacro

; ========================
; Select / open (Return, mouse click)
; ========================

0 define-macro pview-select
    !if &not &seq $buffer-bname "*pview*"
        !return
    !endif
    set-variable #l0 $window-line
    set-variable #l1 &lget .pview.entries #l0
    !if &seq #l1 ""
        ; The root entry is stored as an empty relative path (always line 1)
        !if &not &equ #l0 1
            ml-write "No entry on this line"
            !return
        !endif
    !endif
    !if &seq &lef #l1 3 "..."
        ; Pagination "... N more ..." line - expand this directory and keep cursor
        set-variable #l2 $window-line
        set-variable #l3 $window-y-scroll
        pview-bump-limit &cat .pview.root &rig #l1 3
        pview-render
        !if &les #l2 &add &llen .pview.entries 1
            #l2 goto-line
        !endif
        !force set-variable $window-y-scroll #l3
        !return
    !endif
    ; Resolve the relative entry against the project root
    set-variable #l1 &cat .pview.root #l1
    !if &seq &rig #l1 -1 "/"
        ; Directory - toggle open/closed, keep cursor
        set-variable #l2 $window-line
        set-variable #l3 $window-y-scroll
        set-variable #l4 &lfind .pview.open #l1
        !if &gre #l4 0
            set-variable .pview.open &ldel .pview.open #l4
        !else
            set-variable .pview.open &lins .pview.open -1 #l1
        !endif
        pview-render
        !if &les #l2 &add &llen .pview.entries 1
            #l2 goto-line
        !endif
        !force set-variable $window-y-scroll #l3
    !else
        ; File - open in the other window, leave browser open
        !force next-window
        find-file #l1
    !endif
!emacro

; ========================
; Line navigation
; ========================

0 define-macro pview-next-line
    !if &less $window-line &llen .pview.entries
        1 next-line
    !endif
!emacro

0 define-macro pview-prev-line
    !if &gre $window-line 1
        1 previous-line
    !endif
!emacro

; ========================
; Refresh (re-run git + re-render)
; ========================

0 define-macro pview-refresh
    !if &not &seq $buffer-bname "*pview*"
        !return
    !endif
    set-variable #l1 $window-line
    set-variable #l2 $window-y-scroll
    ; git-status switches to *pview-git* internally; save and restore buffer
    set-variable #l9 $buffer-bname
    pview-git-status
    !force 0 find-buffer #l9
    pview-render
    !if &les #l1 &add &llen .pview.entries 1
        #l1 goto-line
    !endif
    !force set-variable $window-y-scroll #l2
    ml-write "Project view refreshed"
!emacro

; ========================
; Quit
; ========================

0 define-macro pview-quit
    !if &seq $buffer-bname "*pview*"
        !force delete-buffer "*pview*"
    !endif
!emacro

; ========================
; Mouse handlers for right-click context menu
; ========================

0 define-macro pview-mouse-pick-3
    set-position "\x81"
!emacro

0 define-macro pview-mouse-drop-3
    ; did we start in this window? if not then this is a file dragging event
    set-position "\x83"
    set-variable #l0 $buffer-bname
    1 goto-position "\x81"
    !if &seq #l0 $buffer-bname
        ; same buffer - no drag - do popup menu
        goto-position "\x83"
        pview-context-menu
        !return
    !endif
    ; different buffer - abort drag
    goto-position "\x81"
!emacro

0 define-macro pview-context-menu
    set-variable #l0 @wl
    ; Check line type: pagination marker, directory, or file
    set-variable #l1 &sin "\ecC" #l0
    set-variable #l2 &sin "\ecO" #l0
    set-variable #l3 &sin "\ecM" #l0
    !if #l3
        osd .osd.pview   5 ""  "\HShow More"      0 pview-select
        osd .osd.pview  10 ""  "Refresh \HView"    f pview-refresh
        osd .osd.pview  15 "-" ""
        osd .osd.pview  20 ""  "\HClose View"      f pview-quit
    !elif &or #l1 #l2
        osd .osd.pview   5 ""  "\HOpen/Close Dir"  0 pview-select
        osd .osd.pview  10 ""  "Refresh \HView"    f pview-refresh
        osd .osd.pview  15 "-" ""
        osd .osd.pview  20 ""  "\HClose View"      f pview-quit
    !else
        osd .osd.pview   5 ""  "\HOpen File"       0 pview-select
        osd .osd.pview  10 ""  "Refresh \HView"    f pview-refresh
        osd .osd.pview  15 "-" ""
        osd .osd.pview  20 ""  "\HClose View"      f pview-quit
    !endif
    .osd.pview osd
!emacro

; ========================
; Toggle UTF-8 icons
; ========================

define-macro pview-icons-toggle
  !if &not &exist .pview.icons
    set-variable .pview.icons 0
  !endif
  !if .pview.icons
    set-variable .pview.icons 0
    ml-write "Project view: icons off"
  !else
    set-variable .pview.icons 1
    ml-write "Project view: icons on"
  !endif
  !if &seq $buffer-bname "*pview*"
    pview-refresh
  !endif
!emacro

; ========================
; Toolbar tool integration
; ========================

define-macro pview-tool-create
    ; Called by the toolbar when the *pview* tool buffer is created or the
    ; toolbar is opened (tool flag 0x001 - see toolbar.emf). The command
    ; runs in the callers buffer context (toolbar-redraw-tools restores the
    ; callers window only), so the tool buffer is selected explicitly and
    ; the callers position restored afterwards - same pattern as
    ; toolbar-dir-list-create (no popup-window here).
    set-position "\x86"
    find-buffer "*pview*"
    ; Buffer state defaults (same as pview)
    !if &not &exist .pview.icons
        set-variable .pview.icons 0
    !endif
    !if &not &exist .pview.open
        set-variable .pview.open "|"
    !endif
    !if &not &exist .pview.pagelen
        set-variable .pview.pagelen 20
    !endif
    !if &not &exist .pview.pagestep
        set-variable .pview.pagestep 100
    !endif
    ; Set fhook and hilight so the \ec markers highlight correctly
    set-variable $buffer-fhook "fhook-pview"
    !if &and &sin "h" .fhook-pview.setup &band .hilight.flags 0x01
        set-variable $buffer-hilight .hilight.pview
    !endif
    ; Install the buffer key bindings (return/tab/q/r) - the file hook was
    ; registered too late for the initial buffer creation
    fhook-pview
    ; Render once when the buffer is still empty (first toolbar display).
    ; A buffer already filled by M-x pview keeps its state - the toolbar
    ; re-runs this command on every toolbar-open.
    end-of-buffer
    !if &equ $window-eline 1
        set-variable #l0 &stat "a" "."
        !if &not &seq &rig #l0 -1 "/"
            set-variable #l0 &cat #l0 "/"
        !endif
        set-variable #l0 &rep #l0 "//" "/"
        ; Fresh view: drop any previously expanded per-directory limits
        set-variable .pview.limit-path "|"
        set-variable .pview.limit-val "|"
        ; Root always starts open
        !if &not &lfind .pview.open #l0
            set-variable .pview.open &lins .pview.open -1 #l0
        !endif
        set-variable .pview.root #l0
        ; git-status switches to *pview-git* internally; save and restore buffer
        set-variable #l9 $buffer-bname
        pview-git-status
        !force 0 find-buffer #l9
        pview-render
        beginning-of-buffer
    !endif
    goto-position "\x86"
!emacro

buffer-init-fhook "pview"
add-file-hook "*pview*" fhook-pview
