;
; Created:     Sat Sep 15 2001
; Synopsis:    Language setup routines
; Authors:     Steven Phillips, Detlef Groth
;
; Notes:
;     Originally part of language.emf but broken out to keep language.emf
;     clean and speed up start-up
;
0 define-macro spell-rules-init
    !if &not &exi .spell.language
        set-variable #l0 &spr "  Language \"%s\" not supported!  " &reg "/history/language" "Default"
        osd-dialog "Spelling Checker" #l0 "  \HOk  "
        !abort
    !endif
    !force execute-file &cat "lsr" .spell.language
    !if &not $status
        !if @#
            set-variable #l0 &spr "  Rules and dictionaries for language \"%s\"\n     are not available. Install them now?" &reg "/history/language" "Default"
            ; Make Cancel the default to avoid starting a download on Enter.
            osd-xdialog "Spelling Checker" #l0 2 "  \HInstall  " "  \HCancel  "
            !if &equ $result 1
                ; spell-install loads and activates the dictionaries itself.
                !force spell-install .spell.language
                ; Reload the rules, then run the normal dictionary setup below.
                !force execute-file &cat "lsr" .spell.language
                !if &not $status
                    !abort
                !endif
            !endif
        !endif
        !abort
    !endif
    ; Add the eXtended, Main and Personal dictionaries
    add-dictionary &cat "lsdx" .spell.language
    add-dictionary &cat "lsdm" .spell.language
    ; Prefer current German reform spellings over legacy base entries while
    ; allowing personal dictionary entries to override the reform overlay.
    !if &seq .spell.language "dede"
        !if &not &seq &find "lsdmdede-orthography1996" ".edf" "ERROR"
            add-dictionary "lsdmdede-orthography1996"
        !endif
    !endif
    add-dictionary &cat "lsdp" .spell.language
!emacro

; Polish spelling needs characters that ISO-8859-1 cannot represent. Give
; this advice when the user selects Polish, not on every editor startup.
0 define-macro spell-encoding-advice
    !if &and &seq .spell.language "plpl" &seq $internal-encoding "ISO-8859-1"
        7000 ml-write "Polish spelling: ISO-8859-1 lacks Polish letters; consider ISO-8859-2/CP1250."
    !endif
!emacro
