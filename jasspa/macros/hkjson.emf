; copying information.
;
; Synopsis:    JSON language hook (hilight + json.tool lint/format).
;
; Usage:       .json - JSON data files
;
; Notes:       The linter and formatter use python3's standard-library
;              json.tool, so no extra tooling is required. M-x file-lint
;              validates the file (empty result = valid) and M-x file-format
;              rewrites it as indented JSON.
;
define-macro fhook-json
  set-variable $buffer-mask "luh1"
  @# buffer-init "json"
  buffer-init-hooks
!emacro

add-file-hook ".json" fhook-json

; buffer-init variables
set-variable .fhook-json.setup &reg "/history/fhook/json" "fghiopx"
set-variable .fhook-json.setup-mask "aefghikmoptux"

; lint / format using python3's standard-library json.tool
; Accept "python3.exe" as well, because on MSYS2 the binary is stored with a
; .exe suffix and this build's &which only probes the extensionless name.
; Both commands avoid shell operators (no 2>&1, >, &&, ||, mv or rm): the
; native Windows build hands the command's tokens straight to the program, so
; shell redirections would arrive as literal arguments instead of being
; interpreted. Python therefore does the whole job in a single process.
!if &or &not &seq &which "python3" "ERROR" &not &seq &which "python3.exe" "ERROR"
  ; Lint: json.tool writes a valid file's pretty JSON to stdout and its parse
  ; error ("line N column M") to stderr. ME merges stderr into the *file-lint*
  ; buffer on Unix and captures both streams on Windows, so no redirection is
  ; needed. An empty result means the file is valid JSON.
  set-variable %fhook-json-lint "python3 -m json.tool \"%f\""
  ; Format: reformat the file in place within a single python3 process. The
  ; script uses only single quotes inside the double-quoted -c argument, which
  ; keeps it intact both under a POSIX shell and on the native Windows path. A
  ; parse failure aborts before anything is written, so an invalid file is left
  ; untouched.
  set-variable %fhook-json-format "python3 -c \"import json,sys;p=sys.argv[1];d=json.load(open(p,encoding='utf-8'));open(p,'w',encoding='utf-8').write(json.dumps(d,indent=4)+chr(10))\" \"%f\""
  0 define-macro fhook-json-replace
    next-window
    set-variable #l0 $buffer-fname
    previous-window
    fhook-generic-replace "\\(.+\\) line \\([0-9]+\\) column \\([0-9]+\\) " &spr "ERROR: \\1 %s:\\2:\\3 " #l0
  !emacro
!endif

; hilight
!if &and &sin "h" .fhook-json.setup &band .hilight.flags 0x02
  !if &not &exist .hilight.json
    set-variable .hilight.json &pinc .hilight.next 1
  !endif
  0 hilight .hilight.json 0              $global-scheme
  hilight .hilight.json  4 "\"" "\"" "\\" .scheme.string
  hilight .hilight.json  1 "\\d+"        .scheme.constant
  hilight .hilight.json  0 "true"        .scheme.constant
  hilight .hilight.json  0 "false"       .scheme.constant
  hilight .hilight.json  0 "null"        .scheme.constant
  hilight .hilight.json  0 "{"           .scheme.operator
  hilight .hilight.json  0 "}"           .scheme.operator
  hilight .hilight.json  0 "\\["           .scheme.operator
  hilight .hilight.json  0 "\\]"           .scheme.operator
  hilight .hilight.json  0 ":"           .scheme.operator
  hilight .hilight.json  0 ","           .scheme.operator
!endif

buffer-init-fhook "json"
