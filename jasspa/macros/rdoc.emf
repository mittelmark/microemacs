;
; Synopsis:    Browse R help pages in MicroEmacs
; Authors:     MicroEmacs User
;
; Usage:       mec @rdoc <topic>     - Show R help for <topic>
;              mec @rdoc             - Prompt for topic
;
0 define-macro start-up
  execute-file "me"
  delete-other-windows
  set-variable #l0 0
  !while &not &seq $buffer-bname "*scratch*"
    !force file-exists $buffer-bname
    !if &equ $result 0
      r-doc $buffer-bname
      delete-other-windows
      set-variable #l0 1
      !goto end
    !endif
  !done
*end
  !if &equ #l0 0
    r-doc
    delete-other-windows
  !endif
!emacro
