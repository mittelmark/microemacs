set-variable .scheme.scheme-files "|schemed|schemebc|schemedp|schemej|schemead|schemeal|schemeay|schemeaw|schemeat|schemel|schemebh|schemeb|schemecf|schemecl|schemecm|schemecn|schemech|schemedr|schemelj|schemelm|schemel2|schememw|schememd|schemend|schemepl|schemepd|schemevi|schemesf|schemesd|schemesl|schemetd|schemetl|schemetb|schemetw|schemetn|schemege|schemegb|schemego|schemegg|"
