#
# Define the build definitions.
#
TOOLKIT=        winmingwgcc

# BDIST controls build distribution:
#   msys2   - MSYS2 executables (default), needs msys-2.0.dll
#   mingw64 - Native Windows executables, standalone
BDIST    ?= msys2

# Auto-detect MSYS2 environment and set OUTDIR + PKGPFX
# Format: .{env}{subsystem}-release
ifdef MSYSTEM
ifeq "$(MSYSTEM)" "UCRT64"
PKGPFX   = mingw-w64-ucrt-x86_64
else ifeq "$(MSYSTEM)" "MINGW64"
PKGPFX   = mingw-w64-x86_64
else ifeq "$(MSYSTEM)" "MINGW32"
PKGPFX   = mingw-w64-i686
else
PKGPFX   = gcc
endif
else
# MSYSTEM not set (non-MSYS2 build)
endif

ifeq "$(BDIST)" "mingw64"
ifdef MSYSTEM
ifeq "$(MSYSTEM)" "UCRT64"
OUTDIR   =      .ucrt64win-release
else ifeq "$(MSYSTEM)" "MINGW64"
OUTDIR   =      .mingw64win-release
else ifeq "$(MSYSTEM)" "MINGW32"
OUTDIR   =      .mingw32win-release
else
OUTDIR   =      .msys64win-release
endif
else
OUTDIR   =      .msys64win-release
endif
else
ifdef MSYSTEM
ifeq "$(MSYSTEM)" "UCRT64"
OUTDIR   =      .ucrt64msys-release
else ifeq "$(MSYSTEM)" "MINGW64"
OUTDIR   =      .mingw64msys-release
else ifeq "$(MSYSTEM)" "MINGW32"
OUTDIR   =      .mingw32msys-release
else
OUTDIR   =      .msys64msys-release
endif
else
OUTDIR   =      .msys64msys-release
endif
endif

# On MSYS2, use the MinGW gcc that has Windows headers
CC=		gcc
CFLAGS=		-g -O0 -D_WIN32 -I. -Iwin32/include
# For native MSYS2 builds, use system zlib (not win32/lib/libz.a)
LIBS=		-fstack-protector -lssp -lz
#
# Some useful commands
#
RM=		rm -f
RMDIR=          rm -r -f

#
# Define the source and object files.
#
BFSSRC=	bfsutil.c \
		bfs.c \
		uappend.c \
		ubuild.c \
		ucopy.c \
		ucreate.c \
		uinfo.c \
		ulist.c \
		ustrip.c \
		utest.c \
		uxdir.c \
		uxfile.c
BFS=		$(OUTDIR)/bfs.exe
#
#############################################################################
# Rules for the bfsbuild utility.
#
PRGHDRS  = bfs.h bfsutil.h

PRGOBJS  = $(OUTDIR)/bfs.o $(OUTDIR)/bfsutil.o  $(OUTDIR)/uappend.o  $(OUTDIR)/ubuild.o  $(OUTDIR)/ucopy.o  $(OUTDIR)/ucreate.o \
	   $(OUTDIR)/uinfo.o  $(OUTDIR)/ulist.o  $(OUTDIR)/ustrip.o  $(OUTDIR)/utest.o  $(OUTDIR)/uxdir.o  $(OUTDIR)/uxfile.o \
	   $(OUTDIR)/access.o $(OUTDIR)/win32dir.o 

# Define the basic rules.
#
all:		$(OUTDIR) $(PRGOBJS) $(BFS)
#
clean:
		-$(RMDIR) $(OUTDIR)
#
spotless:	clean
		$(RM) *~
		$(RM) core
		$(RM) tags
$(BFS):		$(OUTDIR) $(PRGOBJS)
		$(CC) $(CFLAGS) -o $@ $(PRGOBJS) -fstack-protector -lssp -lz
		cp $(BFS) .
#
$(PRGOBJS): $(PRGHDRS) 

$(OUTDIR)/%.o : %.c
	$(CC) $(CFLAGS) -c -o $@ $<

$(OUTDIR)/access.o : win32/src/access.c
	$(CC) $(CFLAGS) -c -o $@ win32/src/access.c

$(OUTDIR)/win32dir.o : win32/src/win32dir.c
	$(CC) $(CFLAGS) -c -o $@ win32/src/win32dir.c

$(OUTDIR):
	-mkdir $(OUTDIR)

print-info:
	@echo "MSYSTEM=$(MSYSTEM)"
	@echo "OUTDIR=$(OUTDIR)"
	@echo "PKGPFX=$(PKGPFX)"
	@echo "CC=$(CC)"
#
