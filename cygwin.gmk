OS := $(shell uname -o | sed 's/Cygwin/cygwin/')
VERSION := $(shell grep -E 'meYEAR|meMONTH|meDAY' src/evers.h  | head -n 3 | grep -Eo '[0-9b]+' | paste -sd '' | sed 's/0909/09/')
OSV := $(shell uname -r | grep -oE '^[0-9]\.[0-8]')
MACHINE := $(shell uname -m)
RELEASE := cygwin-$(OSV)-$(MACHINE)-microemacs-$(VERSION)
#
# Auto-detect libXft for mew/mecw (override with XFT=0 or XFT=1).
#
PKG_CONFIG ?= pkg-config
ifeq ($(origin XFT), undefined)
XFT=0
ifeq (0,$(shell $(PKG_CONFIG) --exists xft 2>/dev/null; echo $$? ))
XFT=1
endif
endif
XFTDIR=
ifeq ($(XFT),1)
XFTDIR=-xft
endif

app=mecb
default:
	echo "Makefile for Cygwin systems"
	echo "VERSION: '$(VERSION)' OS $(OS) OSVERSION $(OSV) XFT $(XFT)"
	echo "./bfs/bfs -a ./src/mec -o $(RELEASE)-mecb.exe ./jasspa"
bfs/bin:
	cd bfs && make
mec:
	cd src && make -f cygwin.gmk BTYP=c

mew:
	cd src && make -f cygwin.gmk BTYP=w XFT=$(XFT)

mecw:
	cd src && make -f cygwin.gmk BTYP=cw XFT=$(XFT)

mecb: bfs/bin mec
	./bfs/bfs -a ./src/.cygwin-release-mec/mec.exe -o "$(RELEASE)-mecb.exe" ./jasspa

mewb: bfs/bin mew
	./bfs/bfs -a ./src/.cygwin-release-mew$(XFTDIR)/mew.exe -o "$(RELEASE)-mewb.exe" ./jasspa

mecwb: bfs/bin mecw
	./bfs/bfs -a ./src/.cygwin-release-mecw$(XFTDIR)/mecw.exe -o "$(RELEASE)-mecwb.exe" ./jasspa

release: $(app)
	make -f release.gmk app="$(app)" "RELEASE=$(RELEASE)" ext=exe
