##version=091224b1
#
# JASSPA MicroEmacs - www.jasspa.com
# unixgcc.gmk - Top-level make file for Linux, Cygwin and MSYS2 (gcc)
#
# Merged from the former top-level linux32gcc.gmk and cygwin.gmk. The
# platform is auto-detected with "uname -o":
#
#   GNU/Linux -> src/unixgcc.gmk -> .linuxgcc-* output
#   Cygwin    -> src/unixgcc.gmk -> .cygwin-*    output
#   Msys      -> src/unixgcc.gmk -> .msysunix-*  output (MSYS2/mintty)
#
# Run "make -f makefiles/unixgcc.gmk"          for this help
# Run "make -f makefiles/unixgcc.gmk mec"      console build
# Run "make -f makefiles/unixgcc.gmk mew"      X11 build (libXft auto-detected)
# Run "make -f makefiles/unixgcc.gmk mecw"     both
# Run "make -f makefiles/unixgcc.gmk mecb"     standalone console (bfs embedded)
# Run "make -f makefiles/unixgcc.gmk mewb"     standalone X11 (bfs embedded)
# Run "make -f makefiles/unixgcc.gmk mecwb"    standalone both (bfs embedded)
# Run "make -f makefiles/unixgcc.gmk bfs/bin"  build the bfs tool only
# Run "make -f makefiles/unixgcc.gmk release"  package $(app) (default app=mecb)
# Run "make -f makefiles/unixgcc.gmk app-image" Linux only, AppImage from local mecwb
#                            (distro-neutral AppImageBuilder.yml, host libs)
#
##############################################################################
#
# Guard: FreeBSD/Darwin misdetect as PLATFORM=linux via "uname -o", and
# unixgcc.gmk needs GNU make on Linux/Cygwin/MSYS2 anyway.
#
UNAME_S := $(shell uname -s 2>/dev/null)
ifeq ($(UNAME_S),FreeBSD)
$(error FreeBSD: run "make -f makefiles/freebsd.mak" (BSD make) instead - unixgcc.gmk targets Linux/Cygwin/MSYS2)
endif
ifeq ($(UNAME_S),Darwin)
$(error macOS: run "make -f makefiles/macosgcc.gmk" instead - unixgcc.gmk targets Linux/Cygwin/MSYS2)
endif
#
# Platform detection - "uname -o" gives GNU/Linux, Cygwin or Msys.
#
UNAME_O := $(shell uname -o 2>/dev/null)
ifneq (,$(findstring Cygwin,$(UNAME_O)))
PLATFORM := cygwin
else ifneq (,$(findstring Msys,$(UNAME_O)))
PLATFORM := msys
else
PLATFORM := linux
endif

MACHINE := $(shell uname -m)
VERSION := $(shell grep -E '^.define me(YEAR|MONTH|DAY)' src/evers.h | awk '{ print $$3 }' | paste -sd '' | sed 's/"//g')

ifeq ($(PLATFORM),linux)
OS := $(shell uname -o | sed 's/GNU.Linux/linux/')
OSV := $(shell grep -E 'VERSION_ID=' /etc/os-release | sed -E 's/VERSION_ID="?([0-9]+).*"?/\1/')
## check for rolling releases with no version-id
ifeq ($(OSV),)
  OSV=0
endif
KERNEL := $(shell uname -r | grep -oE '^[0-9]')
DIST := $(shell grep -E '^ID=' /etc/os-release | sed -E 's/ID=//')
RELEASE := linux-$(KERNEL)-$(MACHINE)-$(DIST)-$(OSV)-microemacs-$(VERSION)
BUILDID := linuxgcc
EXE :=
OUTPUT_EXT := bin
else ifeq ($(PLATFORM),cygwin)
OS := $(shell uname -o | sed 's/Cygwin/cygwin/')
OSV := $(shell uname -r | grep -oE '^[0-9]\.[0-8]')
RELEASE := cygwin-$(OSV)-$(MACHINE)-microemacs-$(VERSION)
BUILDID := cygwin
EXE := .exe
OUTPUT_EXT := exe
else
OS := msys
OSV := $(shell uname -r | grep -oE '^[0-9]+\.[0-9]+')
RELEASE := msysunix-$(OSV)-$(MACHINE)-microemacs-$(VERSION)
BUILDID := msysunix
EXE := .exe
OUTPUT_EXT := exe
endif

BFSBIN  := ./bfs/bfs$(EXE)
OUTMEC  := ./src/.$(BUILDID)-release-mec/mec$(EXE)
# XFTDIR is computed below, keep these recursive:
OUTMEW  = ./src/.$(BUILDID)-release-mew$(XFTDIR)/mew$(EXE)
OUTMECW = ./src/.$(BUILDID)-release-mecw$(XFTDIR)/mecw$(EXE)

#
# Auto-detect libXft for mew/mecw (override with XFT=0 or XFT=1).
#
PKG_CONFIG ?= pkg-config
ifeq ($(origin XFT), undefined)
XFT=0
ifeq (0,$(shell $(PKG_CONFIG) --exists xft 2>/dev/null; echo $$? ))
XFT=1
endif
endif
XFTDIR=
ifeq ($(XFT),1)
XFTDIR=-xft
endif

app=mecb
default:
	echo "Makefile for unix systems (Linux / Cygwin / MSYS2)"
	echo "VERSION: '$(VERSION)' PLATFORM $(PLATFORM) OS $(OS) OSVERSION $(OSV) XFT $(XFT)"
	echo "RELEASE: $(RELEASE)"
bfs/bin:
	cd bfs && make
mec:
	cd src && make -f unixgcc.gmk BTYP=c

mew:
	cd src && make -f unixgcc.gmk BTYP=w XFT=$(XFT)

mecw:
	cd src && make -f unixgcc.gmk BTYP=cw XFT=$(XFT)

nec:
	cd src && make -f unixgcc.gmk BCOR=ne BTYP=c

# bfs writes its output with fopen("wb+") -> mode 0666 & ~umask = 644,
# so force the executable bit on every standalone (bfs embedded) binary.
mecb: bfs/bin mec
	$(BFSBIN) -a $(OUTMEC) -o "$(RELEASE)-mecb.$(OUTPUT_EXT)" ./jasspa
	chmod 755 "$(RELEASE)-mecb.$(OUTPUT_EXT)"

mewb: bfs/bin mew
	$(BFSBIN) -a $(OUTMEW) -o "$(RELEASE)-mewb.$(OUTPUT_EXT)" ./jasspa
	chmod 755 "$(RELEASE)-mewb.$(OUTPUT_EXT)"

mecwb: bfs/bin mecw
	$(BFSBIN) -a $(OUTMECW) -o "$(RELEASE)-mecwb.$(OUTPUT_EXT)" ./jasspa
	chmod 755 "$(RELEASE)-mecwb.$(OUTPUT_EXT)"

release: $(app)
	make -f makefiles/release.gmk app="$(app)" "RELEASE=$(RELEASE)" ext=$(OUTPUT_EXT)

#
# Build a Linux AppImage directly from the locally built standalone binary
# "$(RELEASE)-mecwb.bin" using "appimage-builder" (https://appimage-builder
# .readthedocs.io) instead of downloading a pre-built binary from a GitHub
# release.
#
# The distro-neutral recipe AppImageBuilder.yml is used: nothing is bundled
# and the AppImage relies on the shared libraries of the host. Minimum host
# requirements (present on any desktop Linux system):
#
#   glibc >= 2.36        Debian 12+, Ubuntu 22.04+, Fedora 36+, Arch, ...
#   libX11.so.6          libx11-6 / libX11
#   libXft.so.2          libxft2 / libXft
#   libtinfo.so.6        libncurses6 / ncurses-libs
#   libz.so.1            zlib1g / zlib
#
# The AppDir is staged in appimage-build/AppDir so that the tracked files
# in jme.AppDir/ stay untouched. Packaging uses appimage-builder with
# --skip-build: the staged AppDir (including the AppRun script) is packaged
# as-is by the type2 AppImageKit runtime. The AppRun script runs jme through
# the host dynamic linker (/lib64/ld-linux-x86-64.so.2) because a full
# appimage-builder build rewrites PT_INTERP to a relative path and replaces
# AppRun with its own ELF + AppRun.env.
#
# Optional platform tag in the AppImage file name (used by CI), e.g.:
#   make -f makefiles/unixgcc.gmk app-image APPIMAGE_PLATFORM_SUFFIX=_ubuntu-22.04
# -> Jasspa_MicroEmacs_<version>_ubuntu-22.04_x86_64.AppImage
# Default is empty (local builds keep the plain name).
#
APPIMAGE_APPDIR := appimage-build/AppDir
APPIMAGE_PLATFORM_SUFFIX ?=
APPIMAGE_FILE   := Jasspa_MicroEmacs_$(VERSION)$(APPIMAGE_PLATFORM_SUFFIX)_x86_64.AppImage
APPIMAGE_RECIPE ?= makefiles/AppImageBuilder.yml
APPIMAGE_ENV    := JME_VERSION=$(VERSION) JME_PLATFORM_SUFFIX=$(APPIMAGE_PLATFORM_SUFFIX)

ifeq ($(PLATFORM),linux)
app-image: mecwb
	@command -v appimage-builder >/dev/null 2>&1 || { \
		echo "app-image: error: 'appimage-builder' not found in PATH" ; \
		echo "app-image: install it first, e.g. 'pipx install appimage-builder'" ; \
		exit 1 ; }
	@test -f "$(APPIMAGE_RECIPE)" || { \
		echo "app-image: error: recipe '$(APPIMAGE_RECIPE)' not found" ; exit 1 ; }
	@echo "app-image: using recipe $(APPIMAGE_RECIPE)"
	@echo "app-image: output $(APPIMAGE_FILE)"
	rm -rf $(APPIMAGE_APPDIR)
	mkdir -p $(APPIMAGE_APPDIR)/usr/bin
	mkdir -p $(APPIMAGE_APPDIR)/usr/share/applications
	mkdir -p $(APPIMAGE_APPDIR)/usr/share/pixmaps
	mkdir -p $(APPIMAGE_APPDIR)/usr/share/spelling
	cp -a jme.AppDir/. $(APPIMAGE_APPDIR)/
	chmod 755 $(APPIMAGE_APPDIR)/AppRun
	cp jme.AppDir/jme.desktop $(APPIMAGE_APPDIR)/usr/share/applications/
	cp jme.AppDir/jme256.png $(APPIMAGE_APPDIR)/usr/share/pixmaps/
	cp -r jasspa/spelling/. $(APPIMAGE_APPDIR)/usr/share/spelling/
	cp "$(RELEASE)-mecwb.$(OUTPUT_EXT)" $(APPIMAGE_APPDIR)/usr/bin/jme
	chmod 755 $(APPIMAGE_APPDIR)/usr/bin/jme
	rm -f $(APPIMAGE_FILE)
	$(APPIMAGE_ENV) appimage-builder --recipe $(APPIMAGE_RECIPE) \
		--appdir $(APPIMAGE_APPDIR) --skip-build
	chmod 755 $(APPIMAGE_FILE)
	./$(APPIMAGE_FILE) -V -n
else
app-image:
	@echo "app-image: error: only supported on Linux (detected PLATFORM=$(PLATFORM))"
	@false
endif

brew: mecb mewb
	mkdir -p brew-linux-$(VERSION)/bin
	cp bin/mecu              brew-linux-$(VERSION)/bin/
	chmod 755                brew-linux-$(VERSION)/bin/mecu  
	cp bfs/bfs               brew-linux-$(VERSION)/bin/
	cp $(RELEASE)-mecb.bin   brew-linux-$(VERSION)/bin/mecb
	cp $(RELEASE)-mewb.bin   brew-linux-$(VERSION)/bin/mewb
	cp COPYING               brew-linux-$(VERSION)/license.txt
	cp docs/README-standalone.md  brew-linux-$(VERSION)/README.md
	tar cfz brew-linux-$(VERSION).tar.gz brew-linux-$(VERSION)/*
	sha256sum brew-linux-$(VERSION).tar.gz > brew-linux-$(VERSION).sha256
