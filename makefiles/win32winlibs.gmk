VERSION=$(shell awk '/^.define meRELEASE/ { gsub(/"/,"",$$3); print $$3 }' src/evers.h)
TOOLKIT=win32winlibs
MAKE=mingw32-make.exe
bfs/exe:
	cd bfs && $(MAKE) -f $(TOOLKIT).gmk
mec: 
	cd src && $(MAKE) -f $(TOOLKIT).mak BTYP=c

mew: 
	cd src && $(MAKE) -f $(TOOLKIT).mak BTYP=w

mecb: bfs/exe mec
	./bfs/bfs.exe -a ./src/.$(TOOLKIT)-release-mec/mec.exe -o mecb-$(VERSION)-winlib.exe ./jasspa

mewb: bfs/exe mew
	./bfs/bfs.exe -a ./src/.$(TOOLKIT)-release-mew/mew.exe -o mewb-$(VERSION)-winlib.exe ./jasspa		
