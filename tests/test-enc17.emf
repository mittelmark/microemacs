; -!- emf -!-
; Ticket 17: escape-mode yank test
; Usage: me @tests/test-enc17
; Verifies that yanking UTF-8 kill text into a single-byte buffer
; produces \uXXXX escapes for characters the buffer encoding cannot
; represent, instead of silent '?' replacements.

define-macro start-up
    find-file "tests/enc-17-src.txt"
    !force set-buffer-encoding utf-8
    beginning-of-buffer
    set-mark
    end-of-buffer
    copy-region
    !force set-buffer-encoding iso-8859-1
    end-of-buffer
    yank
    write-buffer "test-enc17-output.txt"
    exit-emacs
!emacro
