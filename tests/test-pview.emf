; -!- emf -!-
; Test the pview project browser (Ticket 11)
; Usage: MEPATH=jasspa/macros me @tests/test-pview
; Results are written to tests/test-pview-output.txt

execute-file "me"

define-macro start-up
    ; Absolute paths
    set-variable %pview-sample &cat &stat "a" "." "tests/pview-sample/"
    set-variable %pview-sample &rep %pview-sample "//" "/"
    set-variable %pview-out &cat &stat "a" "." "tests/test-pview-output.txt"
    set-variable %pview-out &rep %pview-out "//" "/"

    ; Open pview on the sample directory
    pview %pview-sample

    ; Capture buffer-local state while still in *pview*
    set-variable %pview-root .pview.root
    set-variable %pview-count1 &llen .pview.entries
    set-variable %pview-entry1 &lget .pview.entries 1
    ; Entries store paths relative to .pview.root (root entry = "")
    set-variable %pview-has-subdir &lfind .pview.entries "subdir/"
    set-variable %pview-has-file1 &lfind .pview.entries "file1.txt"
    set-variable %pview-has-hidden &lfind .pview.entries ".hidden.txt"

    ; Expand subdir while in *pview*
    !if &gre %pview-has-subdir 0
        %pview-has-subdir goto-line
        pview-select
        set-variable %pview-has-nested &lfind .pview.entries "subdir/nested.txt"
        set-variable %pview-has-deep &lfind .pview.entries "subdir/.deep.txt"
    !else
        set-variable %pview-has-nested 0
        set-variable %pview-has-deep 0
    !endif

    ; Collapse root (line 1)
    1 goto-line
    pview-select
    set-variable %pview-count2 &llen .pview.entries

    ; --- Pagination (Ticket 11A) ---
    ; Reopen with a small page size: root + 2 children + a "... N more" line
    set-variable .pview.pagelen 2
    pview %pview-sample
    set-variable %pview-page-count &llen .pview.entries
    ; Find the "... N more ..." pseudo-entry
    set-variable %pview-more-idx 0
    set-variable %pview-more-find 1
    ; NB: &les is strict less-than - loop with count+1 for i <= count
    !while &les %pview-more-find &add &llen .pview.entries 1
        !if &seq &lef &lget .pview.entries %pview-more-find 3 "..."
            set-variable %pview-more-idx %pview-more-find
        !endif
        set-variable %pview-more-find &add %pview-more-find 1
    !done
    !if &gre %pview-more-idx 0
        %pview-more-idx goto-line
        set-variable %pview-more-text @wl
        set-variable %pview-more-content &sin "... 2 more ..." %pview-more-text
        ; Click the "..." line - all children must now be shown
        pview-select
        set-variable %pview-page-count2 &llen .pview.entries
        set-variable %pview-page-cursor $window-line
        ; Count remaining "..." entries after expansion
        set-variable %pview-more-again 0
        set-variable %pview-more-find 1
        !while &les %pview-more-find &add &llen .pview.entries 1
            !if &seq &lef &lget .pview.entries %pview-more-find 3 "..."
                set-variable %pview-more-again &add %pview-more-again 1
            !endif
            set-variable %pview-more-find &add %pview-more-find 1
        !done
    !else
        set-variable %pview-more-content 0
        set-variable %pview-page-count2 0
        set-variable %pview-page-cursor 0
        set-variable %pview-more-again 1
    !endif
    ; Restore defaults
    set-variable .pview.pagelen 20
    set-variable .pview.limit-path "|"
    set-variable .pview.limit-val "|"

    ; Now write results
    find-file %pview-out

    insert-string "TEST:pview-root="
    insert-string %pview-root
    insert-newline

    insert-string "TEST:pview-root-slash="
    !if &seq &rig %pview-root -1 "/"
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-entries-count="
    insert-string %pview-count1
    insert-newline

    insert-string "TEST:pview-entry1="
    ; The root entry must be the empty relative path
    !if &seq %pview-entry1 ""
        insert-string "root"
    !else
        insert-string %pview-entry1
    !endif
    insert-newline

    insert-string "TEST:pview-has-subdir="
    !if &gre %pview-has-subdir 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-has-file1="
    !if &gre %pview-has-file1 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-has-hidden="
    !if &gre %pview-has-hidden 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-expanded-nested="
    !if &gre %pview-has-nested 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-expanded-deep-hidden="
    !if &gre %pview-has-deep 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-collapsed-count="
    insert-string %pview-count2
    insert-newline

    insert-string "TEST:pview-page-count="
    insert-string %pview-page-count
    insert-newline

    insert-string "TEST:pview-page-more-line="
    !if &gre %pview-more-idx 0
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-page-more-content="
    !if %pview-more-content
        insert-string "yes"
    !else
        insert-string "no"
    !endif
    insert-newline

    insert-string "TEST:pview-page-expanded-count="
    insert-string %pview-page-count2
    insert-newline

    insert-string "TEST:pview-page-cursor="
    insert-string %pview-page-cursor
    insert-newline

    insert-string "TEST:pview-page-more-after="
    insert-string %pview-more-again
    insert-newline

    insert-string "TEST:all-tests=complete"
    insert-newline
    !force save-buffer
    !force write-buffer %pview-out
    exit-emacs
!emacro
