; -!- emf -!-
; Test basic MicroEmacs functionality for CI testing
; Usage: me @tests/test-basics
; Results are written to tests/test-output.txt

define-macro start-up
    ; Open test output file
    find-file "tests/test-output.txt"

    ; Test 1: Version
    insert-string "TEST:version="
    insert-string $version
    insert-newline

    ; Test 2: Frame dimensions
    insert-string "TEST:frame-width="
    insert-string $frame-width
    insert-newline
    insert-string "TEST:frame-depth="
    insert-string $frame-depth
    insert-newline

    ; Test 3: Window dimensions
    insert-string "TEST:window-width="
    insert-string $window-width
    insert-newline
    insert-string "TEST:window-depth="
    insert-string $window-depth
    insert-newline

    ; Test 4: Buffer name
    insert-string "TEST:buffer-name="
    insert-string $buffer-bname
    insert-newline

    ; Test 5: Test basic arithmetic
    set-variable #l0 &add 1 2
    insert-string "TEST:arithmetic="
    insert-string #l0
    insert-newline

    ; Test 6: Test string operations
    set-variable #l1 &cat "Hello" " World"
    insert-string "TEST:string-cat="
    insert-string #l1
    insert-newline

    ; Test 7: Test platform detection
    insert-string "TEST:platform="
    insert-string $platform
    insert-newline

    ; Test 8: Test system flags
    insert-string "TEST:system="
    insert-string $system
    insert-newline

    ; Test 9: Test encoding variable
    insert-string "TEST:encoding="
    insert-string $encoding
    insert-newline

    ; Test 10: Triple nested while loops (4x4x4 = 64 iterations)
    set-variable #l0 0
    set-variable #l3 0
    !while &les #l0 4
        set-variable #l1 0
        !while &les #l1 4
            set-variable #l2 0
            !while &les #l2 4
                set-variable #l3 &add #l3 1
                set-variable #l2 &add #l2 1
            !done
            set-variable #l1 &add #l1 1
        !done
        set-variable #l0 &add #l0 1
    !done
    insert-string "TEST:nested-while="
    insert-string #l3
    insert-newline

    ; Test 11: Unicode Greek letters round trip (UTF-8)
    insert-string "TEST:unicode="
    insert-string "αβγ"
    insert-newline

    ; Test 12: UTF-8 character based string functions (byte functions stay
    ; byte based: &len/&sin, character functions: &ulen/&uleft/&uright/
    ; &umid/&usin)
    set-variable #l9 "ok"
    !if &not &seq &len "äöü" "6"
        set-variable #l9 "len-bytes"
    !endif
    !if &not &seq &sin "ö" "äöü" "3"
        set-variable #l9 "sin-bytes"
    !endif
    !if &not &seq &ulen "äöü" "3"
        set-variable #l9 "ulen"
    !endif
    !if &not &seq &uleft "äöü" 2 "äö"
        set-variable #l9 "uleft"
    !endif
    !if &not &seq &uleft "äöü" -1 "äö"
        set-variable #l9 "uleft-neg"
    !endif
    !if &not &seq &uright "äöü" -1 "ü"
        set-variable #l9 "uright"
    !endif
    !if &not &seq &umid "äöü" 1 1 "ö"
        set-variable #l9 "umid"
    !endif
    !if &not &seq &usin "ö" "äöü" "2"
        set-variable #l9 "usin"
    !endif
    !if &not &seq &uleft "aä" 2 "aä"
        set-variable #l9 "uleft-mixed"
    !endif
    insert-string "TEST:utf8-strfuncs="
    insert-string #l9
    insert-newline

    ; Test 13: function name lookup - full name first, then the legacy
    ; 3-character chop (gtfun dual-chop). Locks both alias families:
    ; long queries for short entries (&length, &trboth, &lget) and
    ; short queries for the >3 char u-entries (&ulef, &urig, &umi, &usi)
    set-variable #l9 "ok"
    !if &not &seq &length "abc" "3"
        set-variable #l9 "length-alias"
    !endif
    !if &not &seq &trboth " x " "x"
        set-variable #l9 "trboth-alias"
    !endif
    !if &not &seq &lget ",a,b,c" 2 "b"
        set-variable #l9 "lget-alias"
    !endif
    !if &not &seq &ulef "äöü" 2 "äö"
        set-variable #l9 "ulef"
    !endif
    !if &not &seq &urig "hello" 1 "ello"
        set-variable #l9 "urig"
    !endif
    !if &not &seq &umi "äöü" 1 1 "ö"
        set-variable #l9 "umi"
    !endif
    !if &not &seq &usi "ö" "äöü" "2"
        set-variable #l9 "usi"
    !endif
    insert-string "TEST:func-lookup="
    insert-string #l9
    insert-newline

    ; All tests complete
    insert-string "TEST:all-tests=complete"
    insert-newline

    ; Save and exit
    save-buffer
    exit-emacs
!emacro
