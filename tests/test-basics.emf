; -!- emf -!-
; Test basic MicroEmacs functionality for CI testing
; Usage: me @tests/test-basics
; Results are written to tests/test-output.txt

define-macro start-up
    ; Open test output file
    find-file "tests/test-output.txt"

    ; Test 1: Version
    insert-string "TEST:version="
    insert-string $version
    insert-newline

    ; Test 2: Frame dimensions
    insert-string "TEST:frame-width="
    insert-string $frame-width
    insert-newline
    insert-string "TEST:frame-depth="
    insert-string $frame-depth
    insert-newline

    ; Test 3: Window dimensions
    insert-string "TEST:window-width="
    insert-string $window-width
    insert-newline
    insert-string "TEST:window-depth="
    insert-string $window-depth
    insert-newline

    ; Test 4: Buffer name
    insert-string "TEST:buffer-name="
    insert-string $buffer-bname
    insert-newline

    ; Test 5: Test basic arithmetic
    set-variable #l0 &add 1 2
    insert-string "TEST:arithmetic="
    insert-string #l0
    insert-newline

    ; Test 6: Test string operations
    set-variable #l1 &cat "Hello" " World"
    insert-string "TEST:string-cat="
    insert-string #l1
    insert-newline

    ; Test 7: Test platform detection
    insert-string "TEST:platform="
    insert-string $platform
    insert-newline

    ; Test 8: Test system flags
    insert-string "TEST:system="
    insert-string $system
    insert-newline

    ; Test 9: Test encoding variable
    insert-string "TEST:encoding="
    insert-string $encoding
    insert-newline

    ; Test 10: Triple nested while loops (4x4x4 = 64 iterations)
    set-variable #l0 0
    set-variable #l3 0
    !while &les #l0 4
        set-variable #l1 0
        !while &les #l1 4
            set-variable #l2 0
            !while &les #l2 4
                set-variable #l3 &add #l3 1
                set-variable #l2 &add #l2 1
            !done
            set-variable #l1 &add #l1 1
        !done
        set-variable #l0 &add #l0 1
    !done
    insert-string "TEST:nested-while="
    insert-string #l3
    insert-newline

    ; Test 11: Unicode Greek letters round trip (UTF-8)
    insert-string "TEST:unicode="
    insert-string "αβγ"
    insert-newline

    ; Test 12: UTF-8 word characters stay together during word movement
    end-of-buffer
    insert-newline
    insert-string "Anführungszeichen "
    beginning-of-line
    forward-word
    set-variable #l4 $window-col
    set-variable #l5 &len "Anführungszeichen"
    set-variable #l8 "ok"
    !if &not &equ #l4 #l5
        set-variable #l8 "forward-word"
    !endif
    backward-word
    !if &not &equ $window-col 0
        set-variable #l8 "backward-word"
    !endif
    !if &not &seq &inw "ü" "1"
        set-variable #l8 "in-word"
    !endif
    end-of-buffer
    insert-newline
    insert-string "TEST:utf8-word-motion="
    insert-string #l8
    insert-newline

    ; Test 13: spell-word preserves the complete UTF-8 word
    add-dictionary "jasspa/spelling/lsdmenus.edf"
    end-of-buffer
    insert-newline
    insert-string "Überblick "
    beginning-of-line
    12 spell ""
    0 spell
    set-variable #l7 "ok"
    !if &not &seq &lef $result 1 "O"
        set-variable #l7 "spell-status"
    !elif &not &seq &mid $result 1 &len "Überblick" "Überblick"
        set-variable #l7 "spell-word"
    !endif
    set-variable #l3 &rig $result 1
    set-variable #l6 "ok"
    0x401 spell #l3
    !if &not &seq &lef $result 1 "O"
        set-variable #l6 "spell-buffer-argument"
    !endif
    0x800 spell #l3
    set-variable #l2 $result
    0x1000 spell #l2
    !if &not &seq #l3 $result
        set-variable #l6 "spell-entry-encoding"
    !endif
    ; Test replacement of a UTF-8 word preserves the following space
    end-of-buffer
    insert-newline
    insert-string "Läuufe Laufen"
    beginning-of-line
    -3 show-region
    6 forward-char
    3 show-region
    -2 show-region
    &ulen "Läuufe" forward-delete-char
    insert-string "Läufe"
    end-of-line
    set-variable .spell.test-replace "ok"
    !if &not &equ $window-col 13
        set-variable .spell.test-replace "utf8-replace"
    !endif
    end-of-buffer
    insert-newline
    insert-string "TEST:utf8-spell="
    insert-string #l7
    insert-newline
    insert-string "TEST:utf8-spell-entry="
    insert-string #l6
    insert-newline
    insert-string "TEST:utf8-spell-replace="
    insert-string .spell.test-replace
    insert-newline

    ; Test 14: spelling dictionaries can be loaded from the built-in FS
    !if &not &stat "r" "bfs://spelling/lsdmdede-orthography1996.edf"
        set-variable #l5 "not-applicable"
    !else
        add-dictionary "lsdmdede-orthography1996"
        set-variable #l5 "ok"
    !endif
    !if &seq #l5 "ok"
        set-variable #l3 "Tippgeber"
        0x401 spell #l3
        set-variable #l4 $result
        !if &not &seq &lef $result 1 "O"
            set-variable #l5 "bfs-spell-load"
        !endif
    !endif
    end-of-buffer
    insert-newline
    insert-string "TEST:bfs-spell="
    insert-string #l5
    insert-newline
    insert-string "TEST:bfs-spell-result="
    insert-string #l4
    insert-newline
    !if &seq #l5 "ok"
        set-variable #l3 "Tipgeber"
        0x401 spell #l3
        set-variable #l4 $result
        !if &not &seq &lef $result 1 "A"
            set-variable #l5 "bfs-overlay-word"
        !endif
    !endif
    insert-string "TEST:bfs-overlay="
    insert-string #l5
    insert-newline
    insert-string "TEST:bfs-overlay-result="
    insert-string #l4
    insert-newline

    ; Test 15: UTF-8 character based string functions (byte functions stay
    ; byte based: &len/&sin, character functions: &ulen/&uleft/&uright/
    ; &umid/&usin)
    set-variable #l9 "ok"
    !if &not &seq &len "äöü" "6"
        set-variable #l9 "len-bytes"
    !endif
    !if &not &seq &sin "ö" "äöü" "3"
        set-variable #l9 "sin-bytes"
    !endif
    !if &not &seq &ulen "äöü" "3"
        set-variable #l9 "ulen"
    !endif
    !if &not &seq &uleft "äöü" 2 "äö"
        set-variable #l9 "uleft"
    !endif
    !if &not &seq &uleft "äöü" -1 "äö"
        set-variable #l9 "uleft-neg"
    !endif
    !if &not &seq &uright "äöü" -1 "ü"
        set-variable #l9 "uright"
    !endif
    !if &not &seq &umid "äöü" 1 1 "ö"
        set-variable #l9 "umid"
    !endif
    !if &not &seq &usin "ö" "äöü" "2"
        set-variable #l9 "usin"
    !endif
    !if &not &seq &uleft "aä" 2 "aä"
        set-variable #l9 "uleft-mixed"
    !endif
    insert-string "TEST:utf8-strfuncs="
    insert-string #l9
    insert-newline

    ; Test 15: function name lookup - full name first, then the legacy
    ; 3-character chop (gtfun dual-chop). Locks both alias families:
    ; long queries for short entries (&length, &trboth, &lget) and
    ; short queries for the >3 char u-entries (&ulef, &urig, &umi, &usi)
    set-variable #l9 "ok"
    !if &not &seq &length "abc" "3"
        set-variable #l9 "length-alias"
    !endif
    !if &not &seq &trboth " x " "x"
        set-variable #l9 "trboth-alias"
    !endif
    !if &not &seq &lget ",a,b,c" 2 "b"
        set-variable #l9 "lget-alias"
    !endif
    !if &not &seq &ulef "äöü" 2 "äö"
        set-variable #l9 "ulef"
    !endif
    !if &not &seq &urig "hello" 1 "ello"
        set-variable #l9 "urig"
    !endif
    !if &not &seq &umi "äöü" 1 1 "ö"
        set-variable #l9 "umi"
    !endif
    !if &not &seq &usi "ö" "äöü" "2"
        set-variable #l9 "usi"
    !endif
    insert-string "TEST:func-lookup="
    insert-string #l9
    insert-newline

    ; Test 16: PageUp/PageDown framing. Repeated page scrolls must move dot
    ; to the beginning/end of the buffer, not just scroll the view. The
    ; regression was that once the first line was at the top of the window
    ; PageUp reported "top of buffer" and left dot where it was.
    beginning-of-buffer
    !force 3 goto-line
    set-variable #l0 0
    !while &les #l0 40
        !force scroll-up
        set-variable #l0 &add #l0 1
    !done
    set-variable #l5 "fail"
    !if &seq $window-line 1
        set-variable #l5 "ok"
    !endif
    beginning-of-buffer
    set-variable #l0 0
    !while &les #l0 40
        !force scroll-down
        set-variable #l0 &add #l0 1
    !done
    set-variable #l6 "fail"
    !if &seq $window-line $window-eline
        set-variable #l6 "ok"
    !endif
    end-of-buffer
    insert-string "TEST:scroll-bob="
    insert-string #l5
    insert-newline
    insert-string "TEST:scroll-eob="
    insert-string #l6
    insert-newline

    ; All tests complete
    !if &and &and &seq #l8 "ok" &seq #l7 "ok" &seq .spell.test-replace "ok"
        insert-string "TEST:all-tests=complete"
        insert-newline
    !endif

    ; Save and exit
    save-buffer
    exit-emacs
!emacro
